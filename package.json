{
  "name": "groupride",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db.ts migrate",
    "demo:reset": "tsx scripts/db.ts reset",
    "demo": "tsx scripts/demo.ts",
    "test:setup": "node --test tests/setup.test.ts",
    "test:database": "vitest run --config vitest.config.ts",
    "test:matching": "vitest run --config vitest.matching.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "test:readiness": "node --import tsx scripts/check-readiness.ts",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "eval:matching": "node --import tsx scripts/eval-matching.ts",
    "eval:concurrency": "node --import tsx scripts/eval-concurrency.ts",
    "eval:responsiveness": "node --import tsx scripts/eval-responsiveness.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.0.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
