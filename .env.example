# Fictional credentials for the loopback-only Compose databases.
DATABASE_URL=postgresql://groupride_app:local_app@127.0.0.1:55432/groupride_demo
SETUP_DATABASE_URL=postgresql://groupride_setup:local_setup@127.0.0.1:55432/groupride_demo
TEST_DATABASE_URL=postgresql://groupride_app:local_app@127.0.0.1:55432/groupride_test
TEST_SETUP_DATABASE_URL=postgresql://groupride_setup:local_setup@127.0.0.1:55432/groupride_test

# Address trips (docs/ARCHITECTURE-v2.md). Off by default: address search and new
# address estimates are unavailable until a provider is selected. "fixture" runs
# the whole workflow offline with fictional places and driving times: no
# account, no key, no network. The selection signing secret is created lazily
# under .groupride-local/ (ignored by Git) on first use.
# GROUPRIDE_ADDRESS_PROVIDER=fixture

# Optional. Browser writes are accepted only from this app's own loopback origin on
# its listening port (http://127.0.0.1:<port> or http://localhost:<port>). To trust
# other FULL origins instead (scheme, host and port), for example behind a port
# mapping, list them comma-separated. When set, ONLY these are trusted. Node
# scripts and curl send no Origin header and are unaffected.
# GROUPRIDE_TRUSTED_ORIGINS=http://127.0.0.1:3000
